SYNAPSE_ENV=local
SYNAPSE_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opt-in (default off): merge provable broken equals signs into the card and
# let POST /api/v1/sessions/{id}/steps verify a submitted step.
# Changes annotated baseline cards, so golden byte-comparison assumes this is off.
# SYNAPSE_EQUALITY_CHECK=off

# Opt-in (default off): show the focus node's top-2 CHC demand tags on the card.
# Changes the card to schema v0.2, so golden byte-comparison assumes this is off.
# The tags describe the problem, not the student; no ability score is produced.
# SYNAPSE_CHC_ATTRIBUTION=off

# Optional read-only knowledge-card retrieval. Off by default; turning it on
# needs `pip install -e ".[rag]"` and downloads a ~90 MB ONNX model on first run.
# SYNAPSE_RAG=off
# SYNAPSE_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# SYNAPSE_EMBED_CACHE=
# SYNAPSE_RAG_MIN_SCORE=0.35
# SYNAPSE_KNOWLEDGE_PATH=