SYNAPSE_ENV=local
SYNAPSE_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opt-in (default off): merge provable broken equals signs into the card and
# let POST /api/v1/sessions/{id}/steps verify a submitted step.
# Changes annotated baseline cards, so golden byte-comparison assumes this is off.
# SYNAPSE_EQUALITY_CHECK=off