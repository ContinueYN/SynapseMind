SYNAPSE_ENV=local
SYNAPSE_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opt-in (default off): merge provable broken equals signs into the card and
# let POST /api/v1/sessions/{id}/steps verify a submitted step.
# Changes annotated baseline cards, so golden byte-comparison assumes this is off.
# SYNAPSE_EQUALITY_CHECK=off

# Opt-in (default off): show the focus node's top-2 CHC demand tags on the card.
# Changes the card to schema v0.2, so golden byte-comparison assumes this is off.
# The tags describe the problem, not the student; no ability score is produced.
# SYNAPSE_CHC_ATTRIBUTION=off

# Optional read-only knowledge-card retrieval. Off by default; turning it on
# needs `pip install -e ".[rag]"` and downloads a ~90 MB ONNX model on first run.
# SYNAPSE_RAG=off
# SYNAPSE_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# SYNAPSE_EMBED_CACHE=
# SYNAPSE_RAG_MIN_SCORE=0.35
# SYNAPSE_KNOWLEDGE_PATH=

# ---------------------------------------------------------------------------
# Account layer (self-hosted single owner). Everything below is inert while
# SYNAPSE_AUTH=off: no login prompt, no database engine, no gate.
# ---------------------------------------------------------------------------
# Gate /api/v1/sessions... behind a login. Off preserves the local demo.
# SYNAPSE_AUTH=off
# SQLAlchemy URL for users + auth_sessions. Default is a local SQLite file.
# The compose contract is:
#   SYNAPSE_DATABASE_URL=postgresql+psycopg://synapse:synapse@postgres:5432/synapse
# Run `alembic upgrade head` from apps/api (same URL) before starting the API.
# SYNAPSE_DATABASE_URL=sqlite+pysqlite:///var/auth.sqlite3
# Optional: opaque session tokens live in Redis with a TTL; accounts stay in SQL.
# Without it, tokens are rows in auth_sessions.
# SYNAPSE_REDIS_URL=redis://redis:6379/0
# Registration policy: only the first account may self-register. Set on to allow
# more accounts on this instance (otherwise later registrations get 409).
# SYNAPSE_AUTH_ALLOW_SIGNUP=off
# Add Secure to the synapse_session cookie (required when serving over HTTPS).
# SYNAPSE_COOKIE_SECURE=off
# Cookie max-age and server-side session TTL in seconds (default: 7 days).
# SYNAPSE_AUTH_SESSION_TTL_S=604800