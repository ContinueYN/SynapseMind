{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapsemind.dev/schemas/code-execution.schema.json",
  "title": "CodeExecution",
  "description": "代码执行结果（Phase 2，v0.1）。POST /api/v1/executions 的响应；默认关闭，只有显式设置 SYNAPSE_EXEC=on 才运行。pass 只表示进程退出码为 0 或提交的测试全部通过，不表示代码正确、覆盖完整或通过了隐藏测试；fail 只表示进程非零退出或测试失败；timeout 表示超过墙钟上限；rejected 表示静态闸门在运行前拒绝了代码。stdout/stderr 只保留前 max_output_bytes 字节，truncated=true 时不能把它当完整输出。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "detail",
    "exit_code",
    "duration_ms",
    "stdout",
    "stderr",
    "truncated",
    "findings"
  ],
  "properties": {
    "version": {"type": "string", "const": "0.1"},
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "timeout", "rejected"],
      "description": "pass = 退出码 0 或测试通过；fail = 非零退出/测试失败；timeout = 超时被终止；rejected = 静态检查拒绝，未运行。"
    },
    "detail": {
      "type": "string",
      "maxLength": 1000,
      "description": "一句可读说明；pass 必须写明“不证明答案正确”，测试模式必须写明“只跑了提交的测试”。"
    },
    "exit_code": {
      "type": ["integer", "null"],
      "description": "子进程退出码；timeout/rejected 为 null。"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    },
    "stdout": {
      "type": "string",
      "maxLength": 32000
    },
    "stderr": {
      "type": "string",
      "maxLength": 32000
    },
    "truncated": {
      "type": "boolean",
      "description": "stdout 或 stderr 是否因上限被截断。"
    },
    "findings": {
      "type": "array",
      "maxItems": 5,
      "default": [],
      "description": "rejected 时的静态证据；其他状态必须为空数组。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "forbidden_import",
              "forbidden_call",
              "forbidden_attribute",
              "syntax_error",
              "too_large",
              "sandbox_unavailable"
            ]
          },
          "message": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "rejected"}}, "required": ["status"]},
      "then": {
        "properties": {
          "exit_code": {"type": "null"},
          "findings": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["pass", "fail"]}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "exit_code": {"type": "integer"},
          "findings": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "timeout"}}, "required": ["status"]},
      "then": {
        "properties": {
          "exit_code": {"type": "null"},
          "findings": {"maxItems": 0}
        }
      }
    }
  ]
}