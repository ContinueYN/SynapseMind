# Copy to infra/.env (gitignored) and adjust. Every key below already has the
# same default inside infra/compose.yaml, so `docker compose -f
# infra/compose.yaml config` and a bare `up` work without this file.

# ---------------------------------------------------------------------------
# Host
# ---------------------------------------------------------------------------
# Host port for nginx. Use 8080 if something already owns :80.
SYNAPSE_HTTP_PORT=80

# ---------------------------------------------------------------------------
# Postgres (auth data in this slice; the diagnostic store stays SQLite)
# ---------------------------------------------------------------------------
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_DB=synapse

# ---------------------------------------------------------------------------
# API env contract (agreed with the auth/Alembic slice)
# ---------------------------------------------------------------------------
SYNAPSE_ENV=docker
SYNAPSE_DATABASE_URL=postgresql+psycopg://synapse:synapse@postgres:5432/synapse
SYNAPSE_REDIS_URL=redis://redis:6379/0
SYNAPSE_AUTH=on
# Local HTTP has no TLS, so a Secure cookie would never be sent back.
SYNAPSE_COOKIE_SECURE=off
# Multi-user mode. `on` lets anyone register (each account gets its own isolated
# workspace); `off` keeps the old first-owner-only policy.
SYNAPSE_AUTH_ALLOW_SIGNUP=on
# Bring-your-own-key: each logged-in user saves their own model key in the
# settings page. `SYNAPSE_LLM_MODE` must not be `off` for model calls to happen.
SYNAPSE_BYOK=on
# Master key that encrypts every user's saved model key (Fernet/AES).
# Empty = per-user credentials disabled (settings writes answer 503).
# Generate one and keep it out of version control:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means every saved user key must be re-entered; changing it breaks
# decryption of the rows written with the old value.
SYNAPSE_CREDENTIAL_KEY=
# Diagnostic sessions and the review queue are still SQLite files on the
# `appdata` volume; this is not a full Postgres migration.
SYNAPSE_SESSION_DB=/data/synapse.sqlite3
SYNAPSE_REVIEW_DB=/data/review.sqlite3
# Browser origin for CORS. Same-origin calls through nginx need the host only.
SYNAPSE_WEB_ORIGINS=http://localhost,http://127.0.0.1

# ---------------------------------------------------------------------------
# Web (baked into the client bundle at image build time)
# ---------------------------------------------------------------------------
# Empty = same origin: the browser calls /api/v1/... and nginx proxies to api.
# Set an absolute origin (e.g. http://localhost) only if you front the app
# differently; changing it requires rebuilding the web image.
NEXT_PUBLIC_API_BASE=

# ---------------------------------------------------------------------------
# Optional features. The model path is ON because BYOK is on: a user's saved
# key is used when present, and a call without one falls back to the rule path.
# Execution/RAG stay off by default.
# ---------------------------------------------------------------------------
# SYNAPSE_LLM_MODE=on
# SYNAPSE_EXEC=off
# SYNAPSE_RAG=off
# CHC is on in compose so the card shows all seven problem-side demand tags;
# it describes what the task asks for, not an ability/IQ score.
# SYNAPSE_CHC_ATTRIBUTION=on
# Optional server-wide fallback key. A user's own saved key wins; this one is
# used for anonymous/local requests and accounts that have not saved a key.
# DEEPSEEK_API_KEY=
# Session rotation uses one-time cookies; keep the browser client single-flight
# (serialize authenticated requests) or a concurrent request will look like a
# stolen cookie and force a logout.
# SYNAPSE_AUTH_SESSION_TTL_S=604800

# ---------------------------------------------------------------------------
# TLS / reverse proxy in front
# ---------------------------------------------------------------------------
# There is no TLS termination here. When you add HTTPS in front, set
# SYNAPSE_COOKIE_SECURE=on, add the public origin to SYNAPSE_WEB_ORIGINS, and
# rebuild web if NEXT_PUBLIC_API_BASE must become absolute.